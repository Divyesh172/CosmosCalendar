"""
CosmosCommand - Master Pipeline Runner (run_pipeline.py)
Orchestrates Phase 1 (Discovery Agent) and Phase 2 (Verification Agent),
producing cryptographically signed, verified space intelligence for CosmosCommand.
"""

import sys
import os
import time

CURRENT_DIR = os.path.dirname(os.path.abspath(__file__))
